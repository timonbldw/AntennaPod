<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/skipAnalysisRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AntennaPod.TextView.ListItemPrimaryTitle" />

        <TextView
            android:id="@+id/skipAnalysisRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AntennaPod.TextView.ListItemSecondaryTitle"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/skipAnalysisMatchQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AntennaPod.TextView.ListItemSecondaryTitle"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <Button
        android:id="@+id/skipAnalysisListen"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audio_skip_playback_listen" />

    <Button
        android:id="@+id/skipAnalysisJump"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audio_skip_playback_jump_to_end" />

</LinearLayout>
