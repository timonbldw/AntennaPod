<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/audio_skip_source_section" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/audioSkipSampleEpisode"
        android:text="@string/audio_skip_source_episode"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <Spinner
        android:id="@+id/audioSkipSampleEpisode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/audioSkipSampleStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/audio_skip_waveform_loading"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:id="@+id/audioSkipWaveformContainer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="?attr/colorSurfaceVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:labelFor="@id/audioSkipWindowPosition"
        android:text="@string/audio_skip_window_position"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <SeekBar
        android:id="@+id/audioSkipWindowPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/audio_skip_selection_section" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/audio_skip_sample_start_time"
        app:placeholderText="@string/audio_skip_timestamp_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/audioSkipSampleStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/audioSkipStartFineActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/audio_skip_sample_end_time"
        app:placeholderText="@string/audio_skip_timestamp_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/audioSkipSampleEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/audioSkipEndFineActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/audioSkipZoomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <CheckBox
        android:id="@+id/audioSkipLoopSample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/audio_skip_loop_sample" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/audioSkipPlaySample"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_skip_play_sample" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/audioSkipPlaySurrounding"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_skip_play_surrounding" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/audioSkipStopPreview"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_skip_stop_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audioSkipCancelSample"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/audioSkipSaveSample"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@android:string/ok" />

    </LinearLayout>

</merge>
